    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed/run.ts"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.5.0"
  },
  "devDependencies": {
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
