rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Seed images are uploaded via the Admin SDK (bypasses these rules).
    match /artists/{artistId}/seed/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // User uploads: each user may only write into their own uid-scoped folder.
    match /artists/{artistId}/uploads/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
