rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Static config (generations taxonomy) — public read, admin-only write (Admin SDK bypasses rules).
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /artists/{artistId} {
      allow read: if true;
      // metrics, votes, compositeScore, rank are only ever written by Cloud Functions
      // (Admin SDK bypasses these rules), so direct client writes are always denied.
      allow write: if false;

      match /pictures/{pictureId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.source == 'user-upload'
          && artistId in request.resource.data.taggedArtists
          && request.resource.data.voteCount == 0;
        // Edits (vote counts) and deletes go through callable functions only.
        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.weeklyArtistVotes == {}
        && request.resource.data.activeUploadCount == 0;
      // Only non-quota fields (displayName, photoURL) may change client-side;
      // vote/upload counters are only mutated by callable functions.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.weeklyArtistVotes == resource.data.weeklyArtistVotes
        && request.resource.data.activeUploadCount == resource.data.activeUploadCount;
      allow delete: if false;
    }

    match /pictureVotes/{voteId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.pictureId;
      allow update, delete: if false;
    }
  }
}
