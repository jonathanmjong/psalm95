rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Static config (generations taxonomy) — public read, admin-only write (Admin SDK bypasses rules).
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Weekly winners archive — public read, written only by the scheduled function.
    match /hallOfFame/{weekId} {
      allow read: if true;
      allow write: if false;
    }

    // Fandom member counts and daily-heart tallies — public read, maintained only by the
    // joinFandom / claimDailyHeart callables and the weekly reset job (Admin SDK).
    match /fandomStats/{artistId} {
      allow read: if true;
      allow write: if false;
    }

    // Weekly head-to-head battle — public read; vote counts only via callable.
    match /battles/{battleId} {
      allow read: if true;
      allow write: if false;
    }
    match /battleVotes/{voteId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.weekId;
      allow update, delete: if false;
    }

    // Finished battles — public read, archived only by the scheduled function.
    match /battleArchive/{weekId} {
      allow read: if true;
      allow write: if false;
    }

    match /artists/{artistId} {
      allow read: if true;
      // metrics, votes, compositeScore, rank are only ever written by Cloud Functions
      // (Admin SDK bypasses these rules), so direct client writes are always denied.
      allow write: if false;

      match /pictures/{pictureId} {
        allow read: if true;
        // Creates go through the createPictureDoc callable so the per-user upload quota,
        // the activeUploadCount increment and the storagePath/url pairing are enforced
        // server-side; edits (vote counts) and deletes are callable-only too. The Admin
        // SDK bypasses these rules, so all writes are denied to clients.
        allow write: if false;
      }

      // Daily ranking snapshots that power the week/month/year trend graphs — written
      // only by the scheduled Cloud Function.
      match /rankingHistory/{dateId} {
        allow read: if true;
        allow write: if false;
      }

      // Fan comments — public read; signed-in users post their own (≤500 chars) and
      // may delete their own. No edits.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.weeklyArtistVotes == {}
        && request.resource.data.activeUploadCount == 0;
      // Only non-quota fields (displayName, photoURL) may change client-side; vote/upload
      // counters and streak/achievement stats are only mutated by callable functions.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.weeklyArtistVotes == resource.data.weeklyArtistVotes
        && request.resource.data.activeUploadCount == resource.data.activeUploadCount
        && request.resource.data.get('totalVotes', 0) == resource.data.get('totalVotes', 0)
        && request.resource.data.get('currentStreak', 0) == resource.data.get('currentStreak', 0)
        && request.resource.data.get('longestStreak', 0) == resource.data.get('longestStreak', 0)
        && request.resource.data.get('lastVoteDate', '') == resource.data.get('lastVoteDate', '')
        && request.resource.data.get('lastHeartDate', '') == resource.data.get('lastHeartDate', '')
        && request.resource.data.get('streakFreezes', 0) == resource.data.get('streakFreezes', 0)
        && request.resource.data.get('referredBy', '') == resource.data.get('referredBy', '')
        && request.resource.data.get('referralCount', 0) == resource.data.get('referralCount', 0)
        && request.resource.data.get('biasArtistId', '') == resource.data.get('biasArtistId', '');
      allow delete: if false;
    }

    match /pictureVotes/{voteId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && voteId == request.auth.uid + '_' + request.resource.data.pictureId;
      allow update, delete: if false;
    }
  }
}
